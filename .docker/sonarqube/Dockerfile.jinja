FROM sonarqube:26.10.0.133078-community

COPY --chown=sonarqube:sonarqube plugins/* /opt/sonarqube/extensions/plugins/
COPY --chown=sonarqube:sonarqube sonar.properties /opt/sonarqube/conf/sonar.properties
COPY webapp/sonarqube-webapp.zip /opt/sonarqube/tmp/sonarqube-webapp.zip

# Replace the web directory with the custom webapp
USER root
RUN apt-get update && apt-get install -y unzip && rm -rf /var/lib/apt/lists/*
RUN cd /opt/sonarqube/tmp && unzip -q sonarqube-webapp.zip && \
    rm -rf /opt/sonarqube/web/* /opt/sonarqube/tmp/sonarqube-webapp.zip && \
    mv /opt/sonarqube/tmp/* /opt/sonarqube/web && \
    chown -R sonarqube /opt/sonarqube/web && \
    rm -rf /opt/sonarqube/tmp
USER sonarqube

