# Server Base URL
sonar.core.serverBaseURL=https://{{ core.domain.sub }}.{{ core.domain.ext }}
# Community Branch Plugin https://github.com/mc1arke/sonarqube-community-branch-plugin#manual-install
# Workaround for java4shell https://community.sonarsource.com/t/security-advisory-java4shell-workaround-for-sonarqube/191330
sonar.web.javaAdditionalOpts=-javaagent:./extensions/plugins/sonarqube-community-branch-plugin.jar=web -XX:-UseBASE64Intrinsics
sonar.ce.javaAdditionalOpts=-javaagent:./extensions/plugins/sonarqube-community-branch-plugin.jar=ce -XX:-UseBASE64Intrinsics
sonar.search.javaAdditionalOpts=-XX:-UseBASE64Intrinsics
{%- if sonarqube is defined and sonarqube.config is defined %}
# Custom configuration
{% for key, value in sonarqube.config.items() -%}
{{ key }}={{ value }}
{% endfor %}
{%- endif %}
{% include '.docker/sonarqube/sonar.custom.properties' ignore missing %}
